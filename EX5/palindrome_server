#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define BUFFER_SIZE 1024

/* Global variables */

int server_fd;
int client_fd;
int port;

struct sockaddr_in server_addr;
struct sockaddr_in client_addr;

socklen_t addr_len;

char buffer[BUFFER_SIZE];
char result[BUFFER_SIZE];

/* Function declarations */

void create_socket();
void setup_server(char ip[], int port);
void run_server();
void handle_client();
int check_palindrome(char str[]);
void send_result();
void close_server();


int main(int argc, char *argv[])
{
    if (argc != 4)
    {
        printf("Usage: %s <type> <IP> <port>\n", argv[0]);
        printf("Example: %s iterative 127.0.0.1 8080\n", argv[0]);
        return 1;
    }

    if (strcmp(argv[1], "iterative") != 0)
    {
        printf("Only iterative mode is supported.\n");
        return 1;
    }

    port = atoi(argv[3]);

    create_socket();

    setup_server(argv[2], port);

    run_server();

    close_server();

    return 0;
}


/* Create TCP socket */

void create_socket()
{
    server_fd = socket(AF_INET, SOCK_STREAM, 0);

    if (server_fd < 0)
    {
        perror("Socket creation failed");
        exit(1);
    }
}


/* Setup server */

void setup_server(char ip[], int port)
{
    int result;

    memset(&server_addr, 0, sizeof(server_addr));

    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(port);

    if (strcmp(ip, "0.0.0.0") == 0)
    {
        server_addr.sin_addr.s_addr = INADDR_ANY;
    }
    else
    {
        result = inet_pton(AF_INET,
                           ip,
                           &server_addr.sin_addr);

        if (result <= 0)
        {
            printf("Invalid IP address.\n");
            close(server_fd);
            exit(1);
        }
    }

    result = bind(server_fd,
                  (struct sockaddr *)&server_addr,
                  sizeof(server_addr));

    if (result < 0)
    {
        perror("Bind failed");
        close(server_fd);
        exit(1);
    }

    result = listen(server_fd, 5);

    if (result < 0)
    {
        perror("Listen failed");
        close(server_fd);
        exit(1);
    }

    printf("\n============================================\n");
    printf("          TCP PALINDROME SERVER\n");
    printf("============================================\n");
    printf("Type : iterative\n");
    printf("IP   : %s\n", ip);
    printf("Port : %d\n", port);
    printf("Server is waiting for clients...\n");
}


/* Run server */

void run_server()
{
    while (1)
    {
        addr_len = sizeof(client_addr);

        client_fd = accept(server_fd,
                           (struct sockaddr *)&client_addr,
                           &addr_len);

        if (client_fd < 0)
        {
            perror("Accept failed");
            continue;
        }

        printf("\nClient connected.\n");

        handle_client();

        close(client_fd);

        printf("Client disconnected.\n");
        printf("Server is waiting for another client...\n");
    }
}


/* Handle client */

void handle_client()
{
    int bytes_received;

    memset(buffer, 0, sizeof(buffer));
    memset(result, 0, sizeof(result));

    bytes_received = recv(client_fd,
                          buffer,
                          BUFFER_SIZE - 1,
                          0);

    if (bytes_received <= 0)
    {
        printf("Client disconnected.\n");
        return;
    }

    buffer[bytes_received] = '\0';

    printf("Received string: %s\n", buffer);

    if (check_palindrome(buffer))
    {
        strcpy(result, "PALINDROME");
    }
    else
    {
        strcpy(result, "NOT A PALINDROME");
    }

    send_result();
}


/* Check palindrome */

int check_palindrome(char str[])
{
    int left;
    int right;

    left = 0;
    right = strlen(str) - 1;

    while (right >= 0 &&
           (str[right] == '\n' ||
            str[right] == '\r'))
    {
        right--;
    }

    while (left < right)
    {
        if (str[left] != str[right])
        {
            return 0;
        }

        left++;
        right--;
    }

    return 1;
}


/* Send result to client */

void send_result()
{
    int bytes_sent;

    bytes_sent = send(client_fd,
                      result,
                      strlen(result),
                      0);

    if (bytes_sent < 0)
    {
        perror("Send failed");
        return;
    }

    printf("Result sent: %s\n", result);
}


/* Close server */

void close_server()
{
    close(server_fd);

    printf("\nServer terminated.\n");
}
