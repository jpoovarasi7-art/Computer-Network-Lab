#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define MAX 4096

int create_socket();
void connect_server(int sock, char ip[], int port);
void send_crc_data(int sock);
void receive_result(int sock);
void close_client(int sock);

void text_to_binary(char text[], char binary[]);
void calculate_crc(char data[], char generator[], char codeword[]);
void change_bit(char data[]);

int main(int argc, char *argv[])
{
    int sock;
    int port;
    int choice;

    if (argc != 3)
    {
        printf("Usage: %s <IP_address> <port>\n", argv[0]);
        return 1;
    }

    port = atoi(argv[2]);

    sock = create_socket();

    connect_server(sock, argv[1], port);

    while (1)
    {
        printf("\n=====================================\n");
        printf("              CRC CLIENT\n");
        printf("=====================================\n");
        printf("1. Give Message\n");
        printf("2. Exit\n");
        printf("Enter your choice: ");

        scanf("%d", &choice);
        getchar();

        if (choice == 1)
        {
            send_crc_data(sock);
            receive_result(sock);
        }
        else if (choice == 2)
        {
            printf("\nClient terminating...\n");
            break;
        }
        else
        {
            printf("\nInvalid choice.\n");
        }
    }

    close_client(sock);

    return 0;
}

int create_socket()
{
    int sock;

    sock = socket(AF_INET, SOCK_STREAM, 0);

    if (sock < 0)
    {
        perror("Socket creation failed");
        exit(1);
    }

    return sock;
}

void connect_server(int sock, char ip[], int port)
{
    struct sockaddr_in serverAddress;

    memset(&serverAddress, 0, sizeof(serverAddress));

    serverAddress.sin_family = AF_INET;
    serverAddress.sin_port = htons(port);

    if (inet_pton(AF_INET,
                  ip,
                  &serverAddress.sin_addr) <= 0)
    {
        printf("Invalid IP address.\n");
        close(sock);
        exit(1);
    }

    if (connect(sock,
                (struct sockaddr *)&serverAddress,
                sizeof(serverAddress)) < 0)
    {
        perror("Connection failed");
        close(sock);
        exit(1);
    }

    printf("\nConnected to server successfully.\n");
}

void send_crc_data(int sock)
{
    char message[MAX / 8];
    char generator[MAX];
    char binary[MAX];
    char codeword[MAX];

    int dataLength;
    int generatorLength;
    int codewordLength;

    printf("\nEnter message: ");

    fgets(message, sizeof(message), stdin);

    message[strcspn(message, "\n")] = '\0';

    if (strlen(message) == 0)
    {
        printf("Message cannot be empty.\n");
        return;
    }

    printf("Enter generator polynomial in binary: ");

    fgets(generator, sizeof(generator), stdin);

    generator[strcspn(generator, "\n")] = '\0';

    generatorLength = strlen(generator);

    if (generatorLength < 2)
    {
        printf("Invalid generator.\n");
        return;
    }

    {
        int i;

        for (i = 0; i < generatorLength; i++)
        {
            if (generator[i] != '0' &&
                generator[i] != '1')
            {
                printf("Generator must contain only 0 and 1.\n");
                return;
            }
        }
    }

    text_to_binary(message, binary);

    printf("\nOriginal binary at CLIENT:\n");
    printf("%s\n", binary);

    calculate_crc(binary,
                  generator,
                  codeword);

    printf("\nCodeword with CRC at CLIENT:\n");
    printf("%s\n", codeword);

    printf("\nDo you want to change a bit?\n");
    printf("1. Yes\n");
    printf("2. No\n");
    printf("Enter choice: ");

    {
        int choice;

        scanf("%d", &choice);
        getchar();

        if (choice == 1)
        {
            change_bit(codeword);

            printf("\nCodeword after bit change:\n");
            printf("%s\n", codeword);
        }
    }

    dataLength = strlen(binary);
    codewordLength = strlen(codeword);

    send(sock,
         &dataLength,
         sizeof(dataLength),
         0);

    send(sock,
         binary,
         dataLength,
         0);

    send(sock,
         &generatorLength,
         sizeof(generatorLength),
         0);

    send(sock,
         generator,
         generatorLength,
         0);

    send(sock,
         &codewordLength,
         sizeof(codewordLength),
         0);

    send(sock,
         codeword,
         codewordLength,
         0);

    printf("\nData sent to server.\n");
}

void text_to_binary(char text[], char binary[])
{
    int i;
    int j;
    int position;
    unsigned char c;

    position = 0;

    for (i = 0; text[i] != '\0'; i++)
    {
        c = text[i];

        for (j = 7; j >= 0; j--)
        {
            if ((c >> j) & 1)
                binary[position++] = '1';
            else
                binary[position++] = '0';
        }
    }

    binary[position] = '\0';
}

void calculate_crc(char data[],
                   char generator[],
                   char codeword[])
{
    int dataLength;
    int generatorLength;
    int totalLength;
    int i;
    int j;

    char temp[MAX];

    dataLength = strlen(data);
    generatorLength = strlen(generator);

    totalLength = dataLength + generatorLength - 1;

    strcpy(temp, data);

    for (i = dataLength; i < totalLength; i++)
    {
        temp[i] = '0';
    }

    temp[totalLength] = '\0';

    for (i = 0;
         i <= totalLength - generatorLength;
         i++)
    {
        if (temp[i] == '1')
        {
            for (j = 0; j < generatorLength; j++)
            {
                if (temp[i + j] == generator[j])
                    temp[i + j] = '0';
                else
                    temp[i + j] = '1';
            }
        }
    }

    strcpy(codeword, data);

    for (i = 0; i < generatorLength - 1; i++)
    {
        codeword[dataLength + i] =
            temp[dataLength + i];
    }

    codeword[totalLength] = '\0';
}

void change_bit(char data[])
{
    int position;
    int length;

    length = strlen(data);

    printf("\nCodeword length = %d bits\n", length);

    printf("Enter bit position to change (1-%d): ",
           length);

    scanf("%d", &position);
    getchar();

    if (position < 1 || position > length)
    {
        printf("Invalid bit position.\n");
        return;
    }

    position--;

    if (data[position] == '0')
        data[position] = '1';
    else
        data[position] = '0';

    printf("Bit %d changed.\n", position + 1);
}

void receive_result(int sock)
{
    int result;
    int bytes;

    bytes = recv(sock,
                 &result,
                 sizeof(result),
                 0);

    if (bytes <= 0)
    {
        printf("Server disconnected.\n");
        exit(1);
    }

    printf("\n=====================================\n");

    if (result == 0)
    {
        printf("SERVER RESULT: NO ERROR DETECTED\n");
    }
    else
    {
        printf("SERVER RESULT: ERROR DETECTED\n");
    }

    printf("=====================================\n");
}

void close_client(int sock)
{
    close(sock);

    printf("-------------------------------------\n");
    printf("Client connection closed.\n");
    printf("Server is still running.\n");
}
