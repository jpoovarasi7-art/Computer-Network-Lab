#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define MAX 4096

int create_socket();
void bind_socket(int serverSocket, int port);
void listen_socket(int serverSocket);
int accept_connection(int serverSocket);
void receive_and_check(int clientSocket);
void close_client(int clientSocket);

int crc_check(char data[], char generator[]);
void print_crc_remainder(char data[], char generator[]);

int main(int argc, char *argv[])
{
    int serverSocket;
    int clientSocket;
    int port;

    if (argc != 2)
    {
        printf("Usage: %s <port>\n", argv[0]);
        return 1;
    }

    port = atoi(argv[1]);

    serverSocket = create_socket();

    bind_socket(serverSocket, port);

    listen_socket(serverSocket);

    while (1)
    {
        clientSocket = accept_connection(serverSocket);

        if (clientSocket < 0)
            continue;

        receive_and_check(clientSocket);

        close_client(clientSocket);

        printf("-------------------------------------\n");
        printf("Client disconnected.\n");
        printf("Waiting for next client...\n");
    }

    return 0;
}

int create_socket()
{
    int serverSocket;

    serverSocket = socket(AF_INET, SOCK_STREAM, 0);

    if (serverSocket < 0)
    {
        perror("Socket creation failed");
        exit(1);
    }

    return serverSocket;
}

void bind_socket(int serverSocket, int port)
{
    struct sockaddr_in serverAddress;

    memset(&serverAddress, 0, sizeof(serverAddress));

    serverAddress.sin_family = AF_INET;
    serverAddress.sin_addr.s_addr = INADDR_ANY;
    serverAddress.sin_port = htons(port);

    if (bind(serverSocket,
             (struct sockaddr *)&serverAddress,
             sizeof(serverAddress)) < 0)
    {
        perror("Bind failed");
        close(serverSocket);
        exit(1);
    }
}

void listen_socket(int serverSocket)
{
    if (listen(serverSocket, 5) < 0)
    {
        perror("Listen failed");
        close(serverSocket);
        exit(1);
    }

    printf("\n=====================================\n");
    printf("             CRC SERVER\n");
    printf("=====================================\n");
    printf("Server READY\n");
    printf("Press Ctrl+C to stop server.\n");
    printf("Waiting for client...\n");
}

int accept_connection(int serverSocket)
{
    int clientSocket;
    struct sockaddr_in clientAddress;
    socklen_t addressLength;

    addressLength = sizeof(clientAddress);

    clientSocket = accept(serverSocket,
                          (struct sockaddr *)&clientAddress,
                          &addressLength);

    if (clientSocket < 0)
    {
        perror("Accept failed");
        return -1;
    }

    printf("-------------------------------------\n");
    printf("Client CONNECTED\n");

    return clientSocket;
}

void receive_and_check(int clientSocket)
{
    int dataLength;
    int generatorLength;
    int codewordLength;
    int bytes;
    int result;

    char originalBinary[MAX];
    char generator[MAX];
    char codeword[MAX];

    while (1)
    {
        bytes = recv(clientSocket,
                     &dataLength,
                     sizeof(dataLength),
                     0);

        if (bytes <= 0)
            break;

        if (dataLength <= 0 || dataLength >= MAX)
            break;

        bytes = recv(clientSocket,
                     originalBinary,
                     dataLength,
                     0);

        if (bytes <= 0)
            break;

        originalBinary[dataLength] = '\0';

        bytes = recv(clientSocket,
                     &generatorLength,
                     sizeof(generatorLength),
                     0);

        if (bytes <= 0)
            break;

        if (generatorLength <= 1 ||
            generatorLength >= MAX)
            break;

        bytes = recv(clientSocket,
                     generator,
                     generatorLength,
                     0);

        if (bytes <= 0)
            break;

        generator[generatorLength] = '\0';

        bytes = recv(clientSocket,
                     &codewordLength,
                     sizeof(codewordLength),
                     0);

        if (bytes <= 0)
            break;

        if (codewordLength <= 0 ||
            codewordLength >= MAX)
            break;

        bytes = recv(clientSocket,
                     codeword,
                     codewordLength,
                     0);

        if (bytes <= 0)
            break;

        codeword[codewordLength] = '\0';

        printf("\n=====================================\n");
        printf("          CRC CHECKING\n");
        printf("=====================================\n");

        printf("\nOriginal Binary Data:\n");
        printf("%s\n", originalBinary);

        printf("\nGenerator:\n");
        printf("%s\n", generator);

        printf("\nReceived Codeword:\n");
        printf("%s\n", codeword);

        printf("\n-------------------------------------\n");
        printf("CRC Division Result\n");
        printf("-------------------------------------\n");

        result = crc_check(codeword, generator);

        if (result == 0)
        {
            printf("\nCRC Remainder:\n");
            print_crc_remainder(codeword, generator);

            printf("\nSTATUS: NO ERROR DETECTED\n");
        }
        else
        {
            printf("\nCRC Remainder is NOT ZERO\n");
            printf("\nSTATUS: ERROR DETECTED\n");
        }

        printf("=====================================\n");

        send(clientSocket,
             &result,
             sizeof(result),
             0);
    }
}

int crc_check(char data[], char generator[])
{
    int dataLength;
    int generatorLength;
    int i;
    int j;

    char temp[MAX];

    dataLength = strlen(data);
    generatorLength = strlen(generator);

    if (dataLength < generatorLength)
        return 1;

    strcpy(temp, data);

    for (i = 0;
         i <= dataLength - generatorLength;
         i++)
    {
        if (temp[i] == '1')
        {
            for (j = 0; j < generatorLength; j++)
            {
                if (temp[i + j] == generator[j])
                    temp[i + j] = '0';
                else
                    temp[i + j] = '1';
            }
        }
    }

    for (i = dataLength - generatorLength + 1;
         i < dataLength;
         i++)
    {
        if (temp[i] == '1')
            return 1;
    }

    return 0;
}

void print_crc_remainder(char data[], char generator[])
{
    int dataLength;
    int generatorLength;
    int i;
    int j;

    char temp[MAX];

    dataLength = strlen(data);
    generatorLength = strlen(generator);

    strcpy(temp, data);

    for (i = 0;
         i <= dataLength - generatorLength;
         i++)
    {
        if (temp[i] == '1')
        {
            for (j = 0; j < generatorLength; j++)
            {
                if (temp[i + j] == generator[j])
                    temp[i + j] = '0';
                else
                    temp[i + j] = '1';
            }
        }
    }

    for (i = dataLength - generatorLength + 1;
         i < dataLength;
         i++)
    {
        printf("%c", temp[i]);
    }

    printf("\n");
}

void close_client(int clientSocket)
{
    close(clientSocket);
}
