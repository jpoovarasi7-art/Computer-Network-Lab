#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

int create_socket();
void connect_server(int sock, char ip[], int port);
void send_number(int sock);
void receive_sum(int sock);
void close_client(int sock);

int main(int argc, char *argv[])
{
    int sock;
    int port;
    int choice;

    if (argc != 3)
    {
        printf("Usage: %s <IP_address> <port>\n", argv[0]);
        return 1;
    }

    port = atoi(argv[2]);

    sock = create_socket();

    connect_server(sock, argv[1], port);

    while (1)
    {
        printf("\n=====================================\n");
        printf("             SUM CLIENT\n");
        printf("=====================================\n");
        printf("1. Give Number\n");
        printf("2. Exit\n");
        printf("Enter your choice: ");

        scanf("%d", &choice);

        if (choice == 1)
        {
            send_number(sock);
            receive_sum(sock);
        }
        else if (choice == 2)
        {
            printf("\nClient terminating...\n");
            break;
        }
        else
        {
            printf("\nInvalid choice.\n");
        }
    }

    close_client(sock);

    return 0;
}

int create_socket()
{
    int sock;

    sock = socket(AF_INET, SOCK_STREAM, 0);

    if (sock < 0)
    {
        perror("Socket creation failed");
        exit(1);
    }

    return sock;
}

void connect_server(int sock, char ip[], int port)
{
    struct sockaddr_in serverAddress;

    memset(&serverAddress, 0, sizeof(serverAddress));

    serverAddress.sin_family = AF_INET;
    serverAddress.sin_port = htons(port);

    if (inet_pton(AF_INET,
                  ip,
                  &serverAddress.sin_addr) <= 0)
    {
        printf("Invalid IP address.\n");
        close(sock);
        exit(1);
    }

    if (connect(sock,
                (struct sockaddr *)&serverAddress,
                sizeof(serverAddress)) < 0)
    {
        perror("Connection failed");
        close(sock);
        exit(1);
    }

    printf("\nConnected to server successfully.\n");
}

void send_number(int sock)
{
    int number;

    printf("\nEnter a number: ");
    scanf("%d", &number);

    if (send(sock,
             &number,
             sizeof(number),
             0) < 0)
    {
        perror("Send failed");
        return;
    }

    printf("Number sent: %d\n", number);
}

void receive_sum(int sock)
{
    int sum;
    int bytes;

    bytes = recv(sock,
                 &sum,
                 sizeof(sum),
                 0);

    if (bytes <= 0)
    {
        printf("Server disconnected.\n");
        exit(1);
    }

    printf("Sum of digits: %d\n", sum);
}

void close_client(int sock)
{
    close(sock);

    printf("-------------------------------------\n");
    printf("Client connection closed.\n");
    printf("Server is still running.\n");
}
