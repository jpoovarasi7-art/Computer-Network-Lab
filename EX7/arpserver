#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#define BUFFER_SIZE 100
#define TABLE_SIZE 10
int server_fd;
int client_fd;
int port;
int bytes;
int i;
int found;
int count = 4;
char requested_ip[BUFFER_SIZE];
char mac_address[BUFFER_SIZE];
char choice[BUFFER_SIZE];
char ip_table[TABLE_SIZE][BUFFER_SIZE] =
{
    "192.168.1.1",
    "192.168.1.2",
    "192.168.1.3",
    "192.168.1.4"
};
char mac_table[TABLE_SIZE][BUFFER_SIZE] =
{
    "AA:BB:CC:DD:EE:01",
    "AA:BB:CC:DD:EE:02",
    "AA:BB:CC:DD:EE:03",
    "AA:BB:CC:DD:EE:04"
};
struct sockaddr_in server_addr;
struct sockaddr_in client_addr;
socklen_t client_len;
void create_socket();
void setup_server();
void display_table();
void run_server();
void handle_client();
void search_table();
void add_entry();
void close_server();
int main(int argc, char *argv[])
{
    if (argc != 3)
    {
        printf("Usage: %s <server> <port>\n", argv[0]);
        return 1;
    }
    port = atoi(argv[2]);
    create_socket();
    setup_server();
    display_table();
    run_server();
    close_server();
    return 0;
}
void create_socket()
{
    server_fd = socket(AF_INET, SOCK_STREAM, 0);
    if (server_fd < 0)
    {
        perror("Socket failed");
        exit(1);
    }
}
void setup_server()
{
    memset(&server_addr, 0, sizeof(server_addr));
    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = INADDR_ANY;
    server_addr.sin_port = htons(port);
    if (bind(server_fd,
             (struct sockaddr *)&server_addr,
             sizeof(server_addr)) < 0)
    {
        perror("Bind failed");
        exit(1);
    }
    listen(server_fd, 5);
    printf("\nTCP ARP SERVER RUNNING ON PORT %d\n", port);
}
void display_table()
{
    printf("\nSERVER HASH TABLE\n");
    for (i = 0; i < count; i++)
    {
        printf("%s -> %s\n",
               ip_table[i],
               mac_table[i]);
    }
}
void run_server()
{
    while (1)
    {
        client_len = sizeof(client_addr);
        client_fd = accept(
            server_fd,
            (struct sockaddr *)&client_addr,
            &client_len
        );
        if (client_fd < 0)
        {
            perror("Accept failed");
            continue;
        }
        printf("\nClient connected.\n");
        handle_client();
        close(client_fd);
        printf("Client disconnected.\n");
    }
}
void handle_client()
{
    memset(requested_ip, 0, sizeof(requested_ip));
    bytes = recv(
        client_fd,
        requested_ip,
        sizeof(requested_ip) - 1,
        0
    );
    if (bytes <= 0)
    {
        return;
    }
    requested_ip[bytes] = '\0';
    printf("\nARP Request received.\n");
    printf("Requested IP: %s\n", requested_ip);
    search_table();
}
void search_table()
{
    found = 0;
    for (i = 0; i < count; i++)
    {
        if (strcmp(requested_ip, ip_table[i]) == 0)
        {
            strcpy(mac_address, mac_table[i]);
            found = 1;
            break;
        }
    }
    if (found == 1)
    {
        printf("IP found in Server Hash Table.\n");
        send(
            client_fd,
            mac_address,
            strlen(mac_address),
            0
        );
    }
    else
    {
        printf("IP not found in Server Hash Table.\n");
        add_entry();
    }
}
void add_entry()
{
    printf("Add this IP to table? (yes/no): ");
    scanf("%s", choice);
    if (strcmp(choice, "yes") == 0)
    {
        if (count >= TABLE_SIZE)
        {
            strcpy(mac_address, "NOT_FOUND");
            send(
                client_fd,
                mac_address,
                strlen(mac_address),
                0
            );
            return;
        }
        printf("Enter MAC Address: ");
        scanf("%s", mac_address);
        strcpy(ip_table[count], requested_ip);
        strcpy(mac_table[count], mac_address);
        count++;
        printf("New entry added successfully.\n");
        send(
            client_fd,
            mac_address,
            strlen(mac_address),
            0
        );
        display_table();
    }
    else
    {
        strcpy(mac_address, "NOT_FOUND");
        send(
            client_fd,
            mac_address,
            strlen(mac_address),
            0
        );
    }
}
void close_server()
{
    close(server_fd);
}
