#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <pthread.h>
#include <time.h>
#include <signal.h>

#define MAX_CLIENTS 50
#define MAX_QUESTIONS 5
#define BUFFER_SIZE 1024
#define USERNAME_SIZE 50
#define PASSWORD_SIZE 50

#define PORT 8080

/* -------------------- Structures -------------------- */

struct User
{
    char username[USERNAME_SIZE];
    char password[PASSWORD_SIZE];
};

struct Question
{
    int id;
    char question[300];
    char optionA[100];
    char optionB[100];
    char optionC[100];
    char optionD[100];
    char answer;
};

struct ClientSession
{
    int socket;
    int authenticated;
    int score;
    int answered[MAX_QUESTIONS];
    char username[USERNAME_SIZE];
};

/* -------------------- Global Variables -------------------- */

int server_socket;

pthread_mutex_t data_mutex = PTHREAD_MUTEX_INITIALIZER;
pthread_mutex_t log_mutex = PTHREAD_MUTEX_INITIALIZER;

/* User database */

struct User users[MAX_CLIENTS] =
