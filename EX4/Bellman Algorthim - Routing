#include <stdio.h>
#define MAX 10
#define INF 999
typedef struct {
    int cost;
    int nextHop;
} Route;
typedef struct {
    Route table[MAX];
} Router;
void getInput(int graph[MAX][MAX], int *n)
{
    int i, j;

    printf("Enter number of routers: ");
    scanf("%d", n);

    printf("Enter the cost matrix (-1 for no path):\n");
    for(i = 0; i < *n; i++)
    {
        for(j = 0; j < *n; j++)
        {
            scanf("%d", &graph[i][j]);

            if(i == j)
                graph[i][j] = 0;
            else if(graph[i][j] == -1)
                graph[i][j] = INF;
        }
    }
}
void initialize(Router routers[MAX], int graph[MAX][MAX], int n)
{
    int i, j;
    for(i = 0; i < n; i++)
    {
        for(j = 0; j < n; j++)
        {
            routers[i].table[j].cost = graph[i][j];

            if(i == j)
                routers[i].table[j].nextHop = i;
            else if(graph[i][j] != INF)
                routers[i].table[j].nextHop = j;
            else
                routers[i].table[j].nextHop = -1;
        }
    }
}
void distanceVector(Router routers[MAX], int n)
{
    int i, j, k, count;
    for(count = 0; count < n - 1; count++)
    {
        for(i = 0; i < n; i++)
        {
            for(j = 0; j < n; j++)
            {
                for(k = 0; k < n; k++)
                {
                    int costViaK = routers[i].table[k].cost + routers[k].table[j].cost;

                    if(costViaK < routers[i].table[j].cost)
                    {
                        routers[i].table[j].cost = costViaK;
                        routers[i].table[j].nextHop = routers[i].table[k].nextHop;
                    }
                }
            }
        }
    }
}
void display(Router routers[MAX], int n)
{
    int i, j;
    for(i = 0; i < n; i++)
    {
        printf("\nRouting Table for Router %d:\n", i);
        printf("Dest\tCost\tNext Hop\n");
        for(j = 0; j < n; j++)
        {
            printf("%d\t", j);
            if(routers[i].table[j].cost == INF)
                printf("INF\t-\n");
            else
                printf("%d\t%d\n", routers[i].table[j].cost, routers[i].table[j].nextHop);
        }
    }
}
int main()
{
   int graph[MAX][MAX];
   Router sample[MAX];
   int n;
   getInput(graph,&n);
   initialize(sample, graph, n);
   distanceVector(sample,n);
   display(sample,n);
   return 0;
}
