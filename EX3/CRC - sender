                l = (int)strlen(header_contig);
                if (l + 8 < (int)sizeof(header_contig)) {
                    for (bb = 7; bb >= 0; --bb) header_contig[l + (7 - bb)] = ((ch >> bb) & 1) ? '1' : '0';
                    header_contig[l + 8] = '\0';
                }
            }
        }
        {
            unsigned int m1,m2,m3,m4;
            int ii, bb;
            if (sscanf(hashTable[destIdx].mac, "%x:%x:%x:%x", &m1,&m2,&m3,&m4) == 4) {
                unsigned char bytes[4];
                bytes[0] = (unsigned char)m1; bytes[1] = (unsigned char)m2;
                bytes[2] = (unsigned char)m3; bytes[3] = (unsigned char)m4;
                for (ii = 0; ii < 4; ++ii) {
                    int l = (int)strlen(header_spaced);
                    if (l + 9 < (int)sizeof(header_spaced)) {
                        for (bb = 7; bb >= 0; --bb) header_spaced[l + (7 - bb)] = ((bytes[ii] >> bb) & 1) ? '1' : '0';
                        header_spaced[l + 8] = '\0';
                        strcat(header_spaced, " ");
                    }
                    l = (int)strlen(header_contig);
                    if (l + 8 < (int)sizeof(header_contig)) {
                        for (bb = 7; bb >= 0; --bb) header_contig[l + (7 - bb)] = ((bytes[ii] >> bb) & 1) ? '1' : '0';
                        header_contig[l + 8] = '\0';
                    }
                }
            }
            if (sscanf(hashTable[srcIdx].mac, "%x:%x:%x:%x", &m1,&m2,&m3,&m4) == 4) {
                unsigned char bytes[4];
                bytes[0] = (unsigned char)m1; bytes[1] = (unsigned char)m2;
                bytes[2] = (unsigned char)m3; bytes[3] = (unsigned char)m4;
                for (ii = 0; ii < 4; ++ii) {
                    int l = (int)strlen(header_spaced);
                    if (l + 9 < (int)sizeof(header_spaced)) {
                        for (bb = 7; bb >= 0; --bb) header_spaced[l + (7 - bb)] = ((bytes[ii] >> bb) & 1) ? '1' : '0';
