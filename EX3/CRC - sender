                    l = (int)strlen(header_contig);
                    if (l + 8 < (int)sizeof(header_contig)) {
                        for (bb = 7; bb >= 0; --bb) header_contig[l + (7 - bb)] = ((bytes[ii] >> bb) & 1) ? '1' : '0';
                        header_contig[l + 8] = '\0';
                    }
                }
            }
        }
        {
            int v1,v2,v3,v4;
            int ii, bb;
            if (sscanf(hashTable[srcIdx].ip, "%d.%d.%d.%d", &v1,&v2,&v3,&v4) == 4) {
                unsigned char bytes[4];
                bytes[0] = (unsigned char)v1; bytes[1] = (unsigned char)v2;
                bytes[2] = (unsigned char)v3; bytes[3] = (unsigned char)v4;
                for (ii = 0; ii < 4; ++ii) {
                    int l = (int)strlen(header_spaced);
                    if (l + 9 < (int)sizeof(header_spaced)) {
                        for (bb = 7; bb >= 0; --bb) header_spaced[l + (7 - bb)] = ((bytes[ii] >> bb) & 1) ? '1' : '0';
                        header_spaced[l + 8] = '\0';
                        strcat(header_spaced, " ");
                    }
                    l = (int)strlen(header_contig);
                    if (l + 8 < (int)sizeof(header_contig)) {
                        for (bb = 7; bb >= 0; --bb) header_contig[l + (7 - bb)] = ((bytes[ii] >> bb) & 1) ? '1' : '0';
                        header_contig[l + 8] = '\0';
                    }
                }
            }
        }
        {
            unsigned char high = (unsigned char)((hashTable[srcIdx].port >> 8) & 0xFF);
            unsigned char low  = (unsigned char)(hashTable[srcIdx].port & 0xFF);
            int bb;
            int l = (int)strlen(header_spaced);
            if (l + 9 < (int)sizeof(header_spaced)) {
                for (bb = 7; bb >= 0; --bb) header_spaced[l + (7 - bb)] = ((high >> bb) & 1) ? '1' : '0';
                header_spaced[l + 8] = '\0';
                strcat(header_spaced, " ");
            }
            l = (int)strlen(header_contig);
            if (l + 8 < (int)sizeof(header_contig)) {
                for (bb = 7; bb >= 0; --bb) header_contig[l + (7 - bb)] = ((high >> bb) & 1) ? '1' : '0';
                header_contig[l + 8] = '\0';
            }
            l = (int)strlen(header_spaced);
            if (l + 9 < (int)sizeof(header_spaced)) {
                for (bb = 7; bb >= 0; --bb) header_spaced[l + (7 - bb)] = ((low >> bb) & 1) ? '1' : '0';
                header_spaced[l + 8] = '\0';
                strcat(header_spaced, " ");
            }
            l = (int)strlen(header_contig);
            if (l + 8 < (int)sizeof(header_contig)) {
                for (bb = 7; bb >= 0; --bb) header_contig[l + (7 - bb)] = ((low >> bb) & 1) ? '1' : '0';
                header_contig[l + 8] = '\0';
            }
        }
        build_payload_bits_whole(fileData, payload_spaced, (int)sizeof(payload_spaced), payload_contig, (int)sizeof(payload_contig));
        Data_stuffing_binary(fileData);
        Network_packets(fileData, packet_size_bits, frame_size_bits);
        {
            const char *SYN = "00010110";
            const char *SOH = "00000001";
            const char *STX = "00000010";
            const char *ETX = "00000011";
            FILE *outf = fopen(outname, "w");
            if (outf == NULL) {
                printf("Error opening output file '%s' for writing\n", outname);
            } else {
                fprintf(outf, "%s %s %s %s %s %s %s %s\n",
                    SYN, SYN, SOH,
                    header_spaced,
                    STX,
                    payload_spaced,
                    ETX,
                    all_frame_crcs[0] ? all_frame_crcs : "");
                fclose(outf);
            }
        }
    }
    return 0;
