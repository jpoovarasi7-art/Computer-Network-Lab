void int_binary(char num)
{
   int i,p=0;
   for(i=6;i>=0;i--)
   {
      binary[p] = ((num>>i) & 1) + '0';
      p=p+1;
   }
   binary[p]='\0';
  // binary[p+1]='\0';
}
void checking()
{
   int i,bit;
   int count=0;
   for(i=0;i<strlen(binary);i++)
   {
      if(binary[i]=='1')
      {
         count=count+1;
      }
   }
   if(count==0 || count==2 || count== 4 || count==6)
   {
      printf("Given number is not odd parity %s\n",binary);
      printf("Error detection???:");
      scanf("%s",choice);
      if(strcmp(choice,"yes")==0)
      {
         binary[7]='1';
         printf("After one bit changed is %s\n",binary);
      }
   }
   else
   {
      binary[7]='0';
      printf("Given number is odd parity %s\n",binary);
   }
}
