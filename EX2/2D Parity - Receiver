#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

/* Parse integers from a line until a '#' comment or end.
   Fills up to max_ints into out[] and returns count. */
static int parse_ints_from_line(const char *line, int *out, int max_ints)
{
    int count = 0;
    const char *p = line;
    char token[64];
    int ti = 0;

    while (*p != '\0' && count < max_ints) {
        if (*p == '#') break; /* stop at comment */
        if (isdigit((unsigned char)*p) || (*p == '-' && isdigit((unsigned char)*(p+1)))) {
            /* start or continue a number token */
            ti = 0;
            while ((*p != '\0') && (isdigit((unsigned char)*p) || *p == '-')) {
                if (ti < (int)sizeof(token)-1) token[ti++] = *p;
                p++;
            }
            token[ti] = '\0';
            out[count++] = atoi(token);
            continue;
        }
        p++;
    }
    return count;
}

void receiver_2d_odd_parity(void)
{
    char filename[256];
    char line[4096];
    int rows = 0, cols = 0;
    FILE *f = NULL;
    int i, j;

    printf("Enter input filename containing 2D-parity matrix: ");
    if (fgets(filename, sizeof(filename), stdin) == NULL) {
        fprintf(stderr, "No filename provided.\n");
        return;
    }
    /* strip newline */
    {
        size_t ln = strlen(filename);
        if (ln > 0 && filename[ln-1] == '\n') filename[ln-1] = '\0';
        if (filename[0] == '\0') {
            fprintf(stderr, "Empty filename.\n");
            return;
        }
    }

    f = fopen(filename, "r");
    if (!f) {
        fprintf(stderr, "Failed to open file '%s'\n", filename);
        return;
    }

    /* Read first non-empty line to get rows and cols */
    rows = cols = 0;
    while (fgets(line, sizeof(line), f) != NULL) {
        /* skip blank lines */
        int only_ws = 1;
        int p = 0;
        while (line[p] != '\0') {
            if (!isspace((unsigned char)line[p])) { only_ws = 0; break; }
            p++;
        }
        if (only_ws) continue;

        /* parse two ints */
        int tmp[16];
        int got = parse_ints_from_line(line, tmp, 16);
        if (got >= 2) {
            rows = tmp[0];
            cols = tmp[1];
            break;
        } else {
            fprintf(stderr, "Invalid header line. Expect: rows cols\n");
            fclose(f);
            return;
        }
    }

    if (rows <= 0 || cols <= 0) {
        fprintf(stderr, "Invalid rows/cols read from file.\n");
        fclose(f);
        return;
    }

    /* allocate arrays */
    int *data = (int *)malloc(rows * cols * sizeof(int));
    int *row_sum = (int *)malloc(rows * sizeof(int));
    int *row_parity_given = (int *)malloc(rows * sizeof(int));
    int *col_sum = (int *)malloc(cols * sizeof(int));
    int *col_parity_given = (int *)malloc(cols * sizeof(int));
    int overall_parity_given = 0;

    if (!data || !row_sum || !row_parity_given || !col_sum || !col_parity_given) {
        fprintf(stderr, "Memory allocation failed\n");
        if (f) fclose(f);
        free(data); free(row_sum); free(row_parity_given); free(col_sum); free(col_parity_given);
        return;
    }

    /* initialize trackers */
    for (i = 0; i < rows; ++i) {
        row_sum[i] = 0;
        row_parity_given[i] = -1;
    }
    for (j = 0; j < cols; ++j) {
        col_sum[j] = 0;
        col_parity_given[j] = -1;
    }

    /* Read next 'rows' lines: data bits and row parity */
    for (i = 0; i < rows; ++i) {
        if (fgets(line, sizeof(line), f) == NULL) {
            fprintf(stderr, "Unexpected end of file while reading data rows.\n");
            fclose(f);
            free(data); free(row_sum); free(row_parity_given); free(col_sum); free(col_parity_given);
            return;
        }
        int tmp[64];
        int got = parse_ints_from_line(line, tmp, 64);
        if (got < cols) {
            fprintf(stderr, "Row %d: expected at least %d data bits, found %d\n", i+1, cols, got);
            fclose(f);
            free(data); free(row_sum); free(row_parity_given); free(col_sum); free(col_parity_given);
            return;
        }
        for (j = 0; j < cols; ++j) {
            int v = (tmp[j] == 0) ? 0 : 1;
            data[i * cols + j] = v;
            row_sum[i] += v;
            col_sum[j] += v;
        }
        if (got >= cols + 1) {
            row_parity_given[i] = tmp[cols];
        }
    }

    /* Read column parity and overall parity line */
    if (fgets(line, sizeof(line), f) == NULL) {
        fprintf(stderr, "File ended before column parity line.\n");
    } else {
        int tmp[64];
        int got = parse_ints_from_line(line, tmp, 64);
        if (got >= cols) {
            for (j = 0; j < cols; ++j) {
                col_parity_given[j] = tmp[j];
            }
            if (got >= cols + 1) {
                overall_parity_given = tmp[cols];
            } else {
                overall_parity_given = -1;
            }
        }
    }
    fclose(f);

    /* Display the initial matrix data read from file */
    printf("\nRead matrix (%d rows x %d cols):\n", rows, cols);
    for (i = 0; i < rows; ++i) {
        for (j = 0; j < cols; ++j) {
            if (j > 0) putchar(' ');
            printf("%d", data[i * cols + j]);
        }
        printf("    %d\n", row_parity_given[i]);
    }

    printf("\nColumn parity (given): ");
    for (j = 0; j < cols; ++j) {
        if (j > 0) putchar(' ');
        printf("%d", col_parity_given[j]);
    }
    printf("\nOverall parity (given): %d\n", overall_parity_given);

    /* Ask the user how many bits to flip */
    int num_changes = 0,c=0;
    printf("\nHow many times to change the bit? ");
    if (scanf("%d", &num_changes) == 1 && num_changes > 0) {
        for (c = 0; c < num_changes; ++c) {
            int target_row = 0, target_col = 0;
            printf("Enter row position (1 to %d) and column position (1 to %d) separated by space: ", rows, cols);
            if (scanf("%d %d", &target_row, &target_col) == 2) {
                if (target_row >= 1 && target_row <= rows && target_col >= 1 && target_col <= cols) {
                    /* Flip the specified bit */
                    int index = (target_row - 1) * cols + (target_col - 1);
                    data[index] = data[index] ^ 1;
                    printf("Bit at Row %d, Col %d flipped successfully.\n", target_row, target_col);
                } else {
                    printf("Invalid positions provided. Skipping this modification step.\n");
                }
            }
        }
    }

    /* Print modified matrix for tracking */
    printf("\nModified matrix:\n");
    for (i = 0; i < rows; ++i) {
        for (j = 0; j < cols; ++j) {
            if (j > 0) putchar(' ');
            printf("%d", data[i * cols + j]);
        }
        printf("    %d\n", row_parity_given[i]);
    }

    /* Recalculate row sums and column sums based on modified matrix data */
    for (i = 0; i < rows; ++i) row_sum[i] = 0;
    for (j = 0; j < cols; ++j) col_sum[j] = 0;

    for (i = 0; i < rows; ++i) {
        for (j = 0; j < cols; ++j) {
            row_sum[i] += data[i * cols + j];
            col_sum[j] += data[i * cols + j];
        }
    }

    /* Comprehensive Parity Check Logic */
    {
        int any_error = 0;

        /* Check row parities */
        for (i = 0; i < rows; ++i) {
            int expected = (row_sum[i] % 2 == 0) ? 1 : 0;
            if (expected != row_parity_given[i]) {
                any_error = 1;
                break;
            }
        }

        /* Check column parities */
        int col_parity_ones = 0;
        for (j = 0; j < cols; ++j) {
            int expected = (col_sum[j] % 2 == 0) ? 1 : 0;
            col_parity_ones += expected;
            if (expected != col_parity_given[j]) {
                any_error = 1;
            }
        }

        /* Check overall parity */
        int expected_overall = (col_parity_ones % 2 == 0) ? 1 : 0;
        if (expected_overall != overall_parity_given) {
            any_error = 1;
        }

        /* Output clean outcome status */
        if (!any_error) {
            printf("\nFinal result: No parity errors detected.\n");
        } else {
            printf("\nFinal result: Parity errors detected.\n");
        }
    }

    free(data);
    free(row_sum);
    free(row_parity_given);
    free(col_sum);
    free(col_parity_given);
}

int main(void)
{
    receiver_2d_odd_parity();
    return 0;
}
