#include <stdio.h>
#include <stdlib.h>
#include <string.h>

void sender_hamming(const char *data_input) {
    int m = (int)strlen(data_input);
    int r = 0;

    /* Find smallest r such that 2^r >= m + r + 1 */
    while ((1 << r) < (m + r + 1)) {
        r++;
    }

    int total = m + r;
    int *bits = (int *)calloc(total + 1, sizeof(int)); /* 1-based indexing */
    if (!bits) {
        fprintf(stderr, "Memory allocation failed\n");
        return;
    }

    int *parities = (int *)calloc(r + 1, sizeof(int)); /* store parity values at 1..r */
    if (!parities) {
        fprintf(stderr, "Memory allocation failed\n");
        free(bits);
        return;
    }

    /* Ask user for filename */
    char filename[256];
    printf("Enter output filename (default: hamming_output.txt): ");
    if (fgets(filename, sizeof(filename), stdin) == NULL) {
        strcpy(filename, "hamming_output.txt");
    } else {
        size_t len = strlen(filename);
        if (len > 0 && filename[len - 1] == '\n') filename[len - 1] = '\0';
        if (filename[0] == '\0') strcpy(filename, "hamming_output.txt");
    }

    /* Place data bits into non-power-of-two positions */
    int i, j, k;
    j = 0;
    for (i = 1; i <= total; ++i) {
        if ((i & (i - 1)) == 0) {
            bits[i] = 0; /* parity position */
        } else {
            if (j < m) {
                bits[i] = (data_input[j] == '1') ? 1 : 0;
                j++;
            } else {
                bits[i] = 0;
            }
        }
    }

    /* Calculate parity bits (ODD parity) */
    int pos, parity;
    for (i = 0; i < r; ++i) {
        pos = 1 << i;
        parity = 0;
        for (k = 1; k <= total; ++k) {
            if (k & pos) parity ^= bits[k];
        }
        /* For odd parity, parity bit = parity_of_group ^ 1 */
        bits[pos] = parity ^ 1;
        parities[i + 1] = bits[pos]; /* store as 1..r */
    }

    /* Build final codeword string */
    char *codeword = (char *)malloc(total + 2);
    if (!codeword) {
        fprintf(stderr, "Memory allocation failed\n");
        free(bits);
        free(parities);
        return;
    }
    for (i = 1; i <= total; ++i) {
        codeword[i - 1] = bits[i] ? '1' : '0';
    }
    codeword[total] = '\0';

    /* Write only the codeword value to file (with newline) */
    FILE *f = fopen(filename, "w");
    if (!f) {
        fprintf(stderr, "Failed to open output file '%s'\n", filename);
        free(bits);
        free(parities);
        free(codeword);
        return;
    }
    fprintf(f, "%s\n", codeword);
    fclose(f);

    /* Print detailed output to console (exact format requested) */
    printf("Input data: %s\n", data_input);
    printf("Number of data bits (m): %d\n", m);
    printf("Number of redundant bits (r): %d\n", r);
    printf("Total bits (m + r): %d\n\n", total);

    for (i = 0; i < r; ++i) {
        pos = 1 << i;
        printf("P%d (position %d) = %d\n", pos, pos, parities[i + 1]);
    }

    printf("\nParity type: ODD parity\n");
    printf("Final codeword (positions 1..%d): %s\n\n", total, codeword);

    /* Position / Type / Value lines */
    printf("Position: ");
    for (i = 1; i <= total; ++i) {
        if (i > 1) printf(" ");
        printf("%d", i);
    }
    printf("\n");

    printf("Type:     ");
    for (i = 1; i <= total; ++i) {
        if (i > 1) printf(" ");
        if ((i & (i - 1)) == 0) printf("P");
        else printf("D");
    }
    printf("\n");

    printf("Value:    ");
    for (i = 1; i <= total; ++i) {
        if (i > 1) printf(" ");
        printf("%d", bits[i]);
    }
    printf("\n");

    free(bits);
    free(parities);
    free(codeword);
}

/* main only calls the sender function */
int main(void) {
   char sample[50];
   printf("Enter input in binary:");
   scanf("%s",sample);
   int c;
   while ((c = getchar()) != '\n' && c != EOF);
    sender_hamming(sample);
    return 0;
}
