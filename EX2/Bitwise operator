#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

//Complete the following function.
void calculate_the_maximum(int n, int k) {
    int max_and = 0;
    int max_or = 0;
    int max_xor = 0;

    // Iterate through all unique pairs (a, b) where 1 <= a < b <= n
    for (int a = 1; a < n; a++) {
        for (int b = a + 1; b <= n; b++) {
            int and_res = a & b;
            int or_res = a | b;
            int xor_res = a ^ b;

            // Update max_and if result is less than k
            if (and_res < k && and_res > max_and) {
                max_and = and_res;
            }
            // Update max_or if result is less than k
            if (or_res < k && or_res > max_or) {
                max_or = or_res;
            }
            // Update max_xor if result is less than k
            if (xor_res < k && xor_res > max_xor) {
                max_xor = xor_res;
            }
        }
    }

    // Print the results on separate lines
    printf("%d\n", max_and);
    printf("%d\n", max_or);
    printf("%d\n", max_xor);
}

int main() {
    int n, k;
  
    scanf("%d %d", &n, &k);
    calculate_the_maximum(n, k);
 
    return 0;
}
