#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define MAX_FRAMES 100
#define MAX_DATA 100

/*
 * For timeout demonstration:
 *
 * Frame 2 -> ACK 3 is dropped once.
 *
 * Change to -1 when timeout test is not required.
 */
#define DROP_ACK_FRAME 2

struct Frame
{
    int frame_no;
    int error;
    char data[MAX_DATA];
};

struct CircularQueue
{
    struct Frame frame[MAX_FRAMES];
    int front;
    int rear;
    int count;
};

int sockfd;

struct sockaddr_in receiver_addr;
struct sockaddr_in sender_addr;

socklen_t addr_len;

struct CircularQueue queue;

int expected_frame = 0;

int received[MAX_FRAMES];

int ack_dropped = 0;


/* ---------- Function declarations ---------- */

void initialize_queue();
void create_socket();
void bind_socket(int port);

void insert_queue(struct Frame frame);
int find_buffered_frame(int frame_no);
void remove_buffered_frame(int index);

void send_ack(int frame_no);
void send_nak(int frame_no);

void deliver_buffered_frames();

void process_frame(struct Frame frame);
void receive_frames();

void close_socket();
void run_receiver(int argc, char *argv[]);


/* ---------- Initialization ---------- */

void initialize_queue()
{
    queue.front = 0;
    queue.rear = 0;
    queue.count = 0;

    expected_frame = 0;
int i;
    for (i = 0; i < MAX_FRAMES; i++)
        received[i] = 0;
}


/* ---------- UDP ---------- */

void create_socket()
{
    sockfd = socket(AF_INET,
                    SOCK_DGRAM,
                    0);

    if (sockfd < 0)
    {
        perror("Socket creation failed");
        exit(1);
    }

    addr_len = sizeof(sender_addr);
}

void bind_socket(int port)
{
    memset(&receiver_addr,
           0,
           sizeof(receiver_addr));

    receiver_addr.sin_family =
        AF_INET;

    receiver_addr.sin_addr.s_addr =
        INADDR_ANY;

    receiver_addr.sin_port =
        htons(port);

    if (bind(sockfd,
             (struct sockaddr *)&receiver_addr,
             sizeof(receiver_addr)) < 0)
    {
        perror("Bind failed");
        close(sockfd);
        exit(1);
    }
}


/* ---------- Circular Queue ---------- */

void insert_queue(struct Frame frame)
{
    if (queue.count >= MAX_FRAMES)
    {
        printf("Buffer full\n");
        return;
    }

    /*
     * Don't buffer the same frame twice.
     */
    if (received[frame.frame_no])
        return;

    queue.frame[queue.rear] = frame;

    queue.rear =
        (queue.rear + 1) % MAX_FRAMES;

    queue.count++;
}

int find_buffered_frame(int frame_no)
{
    int index;
    int count;

    index = queue.front;

    for (count = 0;
         count < queue.count;
         count++)
    {
        if (queue.frame[index].frame_no ==
            frame_no)
        {
            return index;
        }

        index =
            (index + 1) % MAX_FRAMES;
    }

    return -1;
}

void remove_buffered_frame(int index)
{
    int current;
    int next;

    if (queue.count == 0)
        return;

    /*
     * Shift circular queue elements.
     */
    current = index;

    while (current != queue.rear)
    {
        next =
            (current + 1) % MAX_FRAMES;

        if (next == queue.rear)
            break;

        queue.frame[current] =
            queue.frame[next];

        current = next;
    }

    queue.rear =
        (queue.rear - 1 + MAX_FRAMES)
        % MAX_FRAMES;

    queue.count--;
}


/* ---------- ACK ---------- */

void send_ack(int frame_no)
{
    int ack;

    ack = frame_no + 1;

    /*
     * Simulate ACK loss only once.
     */
    if (frame_no == DROP_ACK_FRAME &&
        ack_dropped == 0)
    {
        printf("ACK %d lost (simulated)\n",
               ack);

        ack_dropped = 1;

        return;
    }

    sendto(sockfd,
           &ack,
           sizeof(ack),
           0,
           (struct sockaddr *)&sender_addr,
           addr_len);

    printf("ACK %d sent back to sender\n",
           ack);
}


/* ---------- NAK ---------- */

void send_nak(int frame_no)
{
    int nak;

    if (frame_no == 0)
        nak = -1000;
    else
        nak = -frame_no;

    sendto(sockfd,
           &nak,
           sizeof(nak),
           0,
           (struct sockaddr *)&sender_addr,
           addr_len);

    printf("NAK %d sent to request frame %d\n",
           frame_no,
           frame_no);
}


/* ---------- Deliver Buffered Frames ---------- */

void deliver_buffered_frames()
{
    int index;

    while (1)
    {
        index =
            find_buffered_frame(expected_frame);

        if (index == -1)
            break;

        printf("Frame %d delivered to Network Layer "
               "(Data: %s)\n",
               queue.frame[index].frame_no,
               queue.frame[index].data);

        received[expected_frame] = 1;

        expected_frame++;

        remove_buffered_frame(index);
    }
}


/* ---------- Process Frame ---------- */

void process_frame(struct Frame frame)
{
    printf("\nFrame %d arrived\n",
           frame.frame_no);

    /*
     * Error frame.
     */
    if (frame.error == 1)
    {
        printf("Frame %d has error\n",
               frame.frame_no);

        send_nak(frame.frame_no);

        return;
    }

    /*
     * Already delivered.
     * This can happen after timeout retransmission.
     */
    if (frame.frame_no < expected_frame)
    {
        printf("Duplicate Frame %d received\n",
               frame.frame_no);

        /*
         * Send its ACK again.
         */
        send_ack(frame.frame_no);

        return;
    }

    /*
     * Correct expected frame.
     */
    if (frame.frame_no == expected_frame)
    {
        printf("Frame %d received in order\n",
               frame.frame_no);

        /*
         * ACK this frame individually.
         */
        send_ack(frame.frame_no);

        /*
         * Deliver it.
         */
        printf("Frame %d delivered to Network Layer "
               "(Data: %s)\n",
               frame.frame_no,
               frame.data);

        received[expected_frame] = 1;

        expected_frame++;

        /*
         * Deliver any previously buffered
         * consecutive frames.
         */
        deliver_buffered_frames();

        return;
    }

    /*
     * Frame is ahead of expected frame.
     */
    if (frame.frame_no > expected_frame)
    {
        printf("\nMISMATCH DETECTED\n");

        printf("Expected Frame: %d, "
               "but received Frame: %d\n",
               expected_frame,
               frame.frame_no);

        printf("Buffering Frame %d locally\n",
               frame.frame_no);

        insert_queue(frame);

        /*
         * Selective Repeat ACKs the frame
         * that was actually received.
         */
        send_ack(frame.frame_no);

        /*
         * Request only the missing frame.
         */
        send_nak(expected_frame);

        return;
    }
}


/* ---------- Receive ---------- */

void receive_frames()
{
    struct Frame frame;

    while (1)
    {
        if (recvfrom(sockfd,
                     &frame,
                     sizeof(frame),
                     0,
                     (struct sockaddr *)&sender_addr,
                     &addr_len) <= 0)
        {
            continue;
        }

        process_frame(frame);
    }
}


/* ---------- Close ---------- */

void close_socket()
{
    close(sockfd);
}


/* ---------- Main Receiver ---------- */

void run_receiver(int argc, char *argv[])
{
    if (argc != 3)
    {
        printf("Usage: %s <IP> <port>\n",
               argv[0]);
        return;
    }

    initialize_queue();

    create_socket();

    bind_socket(atoi(argv[2]));

    printf("\n================================\n");
    printf("   SELECTIVE REPEAT RECEIVER\n");
    printf("================================\n");

    printf("Waiting for frames...\n");

    receive_frames();

    close_socket();
}


int main(int argc, char *argv[])
{
    run_receiver(argc, argv);

    return 0;
}
