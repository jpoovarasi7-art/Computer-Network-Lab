#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <sys/select.h>
#include <errno.h>

#define MAX_FRAMES 100
#define MAX_DATA 100
#define TIMEOUT 3

struct Frame
{
    int frame_no;
    int error;
    char data[MAX_DATA];
};

struct CircularQueue
{
    struct Frame frame[MAX_FRAMES];
    int front;
    int rear;
    int count;
};

int sockfd;
struct sockaddr_in receiver_addr;
struct CircularQueue queue;

int total_frames;
int window_size;
int error_frame;

int error_used = 0;

int acknowledged[MAX_FRAMES];

/* ---------- Function declarations ---------- */

void initialize_queue();
void create_socket();
void set_receiver(char *ip, int port);

void get_input();
void create_frames();

void insert_queue(struct Frame frame);
struct Frame get_frame(int index);

void show_window(int start, int end);
void send_frame(int index);

void receive_window_acks(int start, int end);
void send_nak_retransmission(int frame_no);

void remove_acknowledged(int start, int end);

void close_socket();
void run_sender(int argc, char *argv[]);


/* ---------- Circular Queue ---------- */

void initialize_queue()
{
    queue.front = 0;
    queue.rear = 0;
    queue.count = 0;
int i;
    for (i = 0; i < MAX_FRAMES; i++)
        acknowledged[i] = 0;
}

void insert_queue(struct Frame frame)
{
    if (queue.count >= MAX_FRAMES)
    {
        printf("Queue is full\n");
        return;
    }

    queue.frame[queue.rear] = frame;

    queue.rear =
        (queue.rear + 1) % MAX_FRAMES;

    queue.count++;
}

struct Frame get_frame(int index)
{
    return queue.frame[index];
}


/* ---------- UDP ---------- */

void create_socket()
{
    sockfd = socket(AF_INET, SOCK_DGRAM, 0);

    if (sockfd < 0)
    {
        perror("Socket creation failed");
        exit(1);
    }
}

void set_receiver(char *ip, int port)
{
    memset(&receiver_addr, 0, sizeof(receiver_addr));

    receiver_addr.sin_family = AF_INET;
    receiver_addr.sin_port = htons(port);

    if (inet_pton(AF_INET,
                  ip,
                  &receiver_addr.sin_addr) <= 0)
    {
        printf("Invalid IP address\n");
        exit(1);
    }
}


/* ---------- Input ---------- */

void get_input()
{
    printf("Enter number of frames: ");
    scanf("%d", &total_frames);

    printf("Enter window size: ");
    scanf("%d", &window_size);

    printf("Enter frame number with error (-1 for no error): ");
    scanf("%d", &error_frame);
}

void create_frames()
{
    struct Frame frame;

    printf("\n--- Enter Data for Each Frame ---\n");
int i;
    for (i = 0; i < total_frames; i++)
    {
        frame.frame_no = i;
        frame.error = 0;

        printf("Enter data for Frame %d: ", i);
        scanf(" %[^\n]", frame.data);

        insert_queue(frame);
    }
}


/* ---------- Window ---------- */

void show_window(int start, int end)
{
    printf("\n--------------------------------\n");
    printf("Current Window: ");
int i;
    for (i = start; i <= end; i++)
    {
        if (!acknowledged[i])
            printf("%d ", i);
    }

    printf("\n--------------------------------\n");
}


/* ---------- Sending ---------- */

void send_frame(int index)
{
    struct Frame frame;

    frame = get_frame(index);

    /*
     * Simulate an error only during the
     * first transmission of the selected frame.
     */
    if (frame.frame_no == error_frame &&
        error_used == 0)
    {
        frame.error = 1;
        error_used = 1;

        printf("Frame %d sent with error status\n",
               frame.frame_no);
    }
    else
    {
        frame.error = 0;

        printf("Frame %d sent\n",
               frame.frame_no);
    }

    sendto(sockfd,
           &frame,
           sizeof(frame),
           0,
           (struct sockaddr *)&receiver_addr,
           sizeof(receiver_addr));
}


/*
 * Retransmit a frame after NAK.
 * The retransmitted frame must NOT contain error.
 */
void send_nak_retransmission(int frame_no)
{
    struct Frame frame;

    frame = get_frame(frame_no);

    frame.error = 0;

    printf("Resending Frame %d immediately due to NAK request\n",
           frame_no);

    sendto(sockfd,
           &frame,
           sizeof(frame),
           0,
           (struct sockaddr *)&receiver_addr,
           sizeof(receiver_addr));
}


/* ---------- ACK / Timeout ---------- */

void receive_window_acks(int start, int end)
{
    fd_set readfds;
    struct timeval timeout;

    int response;
    int result;

    int completed = 0;

    /*
     * Number of frames in this window.
     */
    int window_count = end - start + 1;

    while (completed < window_count)
    {
        FD_ZERO(&readfds);
        FD_SET(sockfd, &readfds);

        timeout.tv_sec = TIMEOUT;
        timeout.tv_usec = 0;

        result = select(sockfd + 1,
                        &readfds,
                        NULL,
                        NULL,
                        &timeout);

        /*
         * TIMEOUT
         */
        if (result == 0)
        {
            /*
             * Find an unacknowledged frame.
             * Retransmit only that frame.
             */
           int i;
            for (i = start; i <= end; i++)
            {
                if (!acknowledged[i])
                {
                    printf("Time-out for Frame %d\n", i);

                    printf("Retransmitting Frame %d\n", i);

                    send_nak_retransmission(i);

                    break;
                }
            }

            continue;
        }

        if (FD_ISSET(sockfd, &readfds))
        {
            if (recvfrom(sockfd,
                         &response,
                         sizeof(response),
                         0,
                         NULL,
                         NULL) <= 0)
            {
                continue;
            }

            /*
             * Negative value = NAK
             */
            if (response < 0)
            {
                int frame_no;

                if (response == -1000)
                    frame_no = 0;
                else
                    frame_no = -response;

                /*
                 * Ignore NAK if the frame is already ACKed.
                 */
                if (frame_no >= start &&
                    frame_no <= end &&
                    !acknowledged[frame_no])
                {
                    printf("NAK %d received from receiver\n",
                           frame_no);

                    send_nak_retransmission(frame_no);
                }

                continue;
            }

            /*
             * ACK number = frame number + 1
             */
            int frame_no = response - 1;

            if (frame_no >= start &&
                frame_no <= end &&
                !acknowledged[frame_no])
            {
                acknowledged[frame_no] = 1;

                completed++;

                printf("ACK %d received for Frame %d\n",
                       response,
                       frame_no);
            }
        }
    }
}


/* ---------- Remove frames ---------- */

void remove_acknowledged(int start, int end)
{
   int i;
    for (i = start; i <= end; i++)
    {
        if (acknowledged[i])
        {
            printf("Frame %d removed from window\n",
                   i);
        }
    }
}


/* ---------- Close ---------- */

void close_socket()
{
    close(sockfd);
}


/* ---------- Main Sender ---------- */

void run_sender(int argc, char *argv[])
{
    int start;
    int end;

    if (argc != 3)
    {
        printf("Usage: %s <IP> <port>\n",
               argv[0]);
        return;
    }

    initialize_queue();

    create_socket();

    set_receiver(argv[1],
                 atoi(argv[2]));

    get_input();

    if (window_size <= 0 ||
        window_size > total_frames)
    {
        printf("Invalid window size\n");
        close_socket();
        return;
    }

    create_frames();

    printf("\n================================\n");
    printf("     SELECTIVE REPEAT SENDER\n");
    printf("================================\n");

    start = 0;

    while (start < total_frames)
    {
        end = start + window_size - 1;

        if (end >= total_frames)
            end = total_frames - 1;

        show_window(start, end);

        /*
         * Send every frame in the window.
         */
        int i;
        for (i = start; i <= end; i++)
        {
            if (!acknowledged[i])
                send_frame(i);
        }

        /*
         * Wait for individual ACKs.
         * NAK causes immediate retransmission.
         * Missing ACK causes timeout.
         */
        receive_window_acks(start, end);

        remove_acknowledged(start, end);

        printf("\nWindow moved to next frames.\n");

        start = end + 1;
    }

    printf("\nAll frames transmitted successfully.\n");

    close_socket();
}


int main(int argc, char *argv[])
{
    run_sender(argc, argv);

    return 0;
}
