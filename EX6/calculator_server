#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define BUFFER_SIZE 100

int server_socket;
int port;
int bytes;

float num1;
float num2;
float result;

char operation;
char response[BUFFER_SIZE];

struct sockaddr_in server_addr;
struct sockaddr_in client_addr;

socklen_t client_len;

void create_socket();
void setup_server();
void run_server();
void process_request();
void calculate();
void send_result();
void close_server();

int main(int argc, char *argv[])
{
    if (argc != 2)
    {
        printf("Usage: %s <port>\n", argv[0]);
        return 1;
    }

    port = atoi(argv[1]);

    create_socket();
    setup_server();
    run_server();
    close_server();

    return 0;
}

void create_socket()
{
    server_socket = socket(AF_INET, SOCK_DGRAM, 0);

    if (server_socket < 0)
    {
        perror("Socket creation failed");
        exit(1);
    }
}

void setup_server()
{
    memset(&server_addr, 0, sizeof(server_addr));

    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = INADDR_ANY;
    server_addr.sin_port = htons(port);

    if (bind(server_socket,
             (struct sockaddr *)&server_addr,
             sizeof(server_addr)) < 0)
    {
        perror("Bind failed");
        close(server_socket);
        exit(1);
    }

    printf("\n================================\n");
    printf("       UDP CALCULATOR SERVER\n");
    printf("================================\n");
    printf("Server running on port %d\n", port);
}

void run_server()
{
    while (1)
    {
        client_len = sizeof(client_addr);

        bytes = recvfrom(
            server_socket,
            &operation,
            sizeof(operation),
            0,
            (struct sockaddr *)&client_addr,
            &client_len
        );

        if (bytes <= 0)
        {
            continue;
        }

        if (operation == 'E')
        {
            printf("\nClient requested exit.\n");
            continue;
        }

        recvfrom(
            server_socket,
            &num1,
            sizeof(num1),
            0,
            (struct sockaddr *)&client_addr,
            &client_len
        );

        recvfrom(
            server_socket,
            &num2,
            sizeof(num2),
            0,
            (struct sockaddr *)&client_addr,
            &client_len
        );

        printf("\nRequest received:");
        printf("\nNumber 1 : %.2f", num1);
        printf("\nNumber 2 : %.2f", num2);
        printf("\nOperation: %c\n", operation);

        process_request();
    }
}

void process_request()
{
    calculate();
    send_result();
}

void calculate()
{
    memset(response, 0, sizeof(response));

    if (operation == '+')
    {
        result = num1 + num2;

        sprintf(
            response,
            "Result = %.2f",
            result
        );
    }
    else if (operation == '-')
    {
        result = num1 - num2;

        sprintf(
            response,
            "Result = %.2f",
            result
        );
    }
    else if (operation == '*')
    {
        result = num1 * num2;

        sprintf(
            response,
            "Result = %.2f",
            result
        );
    }
    else if (operation == '/')
    {
        if (num2 == 0)
        {
            strcpy(
                response,
                "Error: Division by zero is not allowed."
            );
        }
        else
        {
            result = num1 / num2;

            sprintf(
                response,
                "Result = %.2f",
                result
            );
        }
    }
    else
    {
        strcpy(
            response,
            "Error: Invalid operation."
        );
    }
}

void send_result()
{
    sendto(
        server_socket,
        response,
        strlen(response) + 1,
        0,
        (struct sockaddr *)&client_addr,
        client_len
    );

    printf("Response sent: %s\n", response);
}

void close_server()
{
    close(server_socket);
}
